# Server Configuration
PORT=8000
HOST=0.0.0.0

# Database Configuration (Defaults to SQLite; easily migrates to PostgreSQL)
DATABASE_URL=sqlite:///./dsa_roadmap.db
# DATABASE_URL=postgresql://user:password@localhost:5432/dsa_roadmap

# AI / LLM Configuration
# Google Gemini API - FREE tier available at https://aistudio.google.com/app/apikey
# Set this in Vercel → Project → Settings → Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini

# JWT Authentication
JWT_SECRET_KEY=your_secure_jwt_secret_here_change_in_production
